{
  "redirects": [
    {
      "source": "/field.html",
      "destination": "/learn-the-field.html",
      "permanent": true
    },
    {
      "source": "/the-field.html",
      "destination": "/learn-the-field.html",
      "permanent": true
    },
    {
      "source": "/The%20Field.html",
      "destination": "/learn-the-field.html",
      "permanent": true
    },
    {
      "source": "/The Field.html",
      "destination": "/learn-the-field.html",
      "permanent": true
    },
    {
      "source": "/.well-known/llms.txt",
      "destination": "/llms.txt",
      "permanent": true
    },
    {
      "source": "/mint-static-artefact.html",
      "destination": "/artefacts.html",
      "permanent": true
    },
    {
      "source": "/mint-static-artefact",
      "destination": "/artefacts.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/skill.md",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/heartbeat.md",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/skill.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/examples/verify-signal.js",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
